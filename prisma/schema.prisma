generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String?
  role         Role          @default(STUDENT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  quizAttempts QuizAttempt[]

  @@map("users")
}

model Question {
  id         String     @id @default(cuid())
  question   String
  options    Json
  answer     String
  difficulty Difficulty @default(MEDIUM)
  category   String
  createdAt  DateTime   @default(now())

  @@map("questions")
}

model Unit1Question {
  id         String     @id @default(cuid())
  question   String
  options    Json
  answer     String
  difficulty Difficulty @default(MEDIUM)
  category   String
  unit       String     // Unit identifier
  createdAt  DateTime   @default(now())

  @@map("unit_1")
}

model Unit2Question {
  id         String     @id @default(cuid())
  question   String
  options    Json
  answer     String
  difficulty Difficulty @default(MEDIUM)
  category   String
  unit       String     // Unit identifier
  createdAt  DateTime   @default(now())

  @@map("unit_2")
}

model Unit3Question {
  id         String     @id @default(cuid())
  question   String
  options    Json
  answer     String
  difficulty Difficulty @default(MEDIUM)
  category   String
  unit       String     // Unit identifier
  createdAt  DateTime   @default(now())

  @@map("unit_3")
}

model Unit4Question {
  id         String     @id @default(cuid())
  question   String
  options    Json
  answer     String
  difficulty Difficulty @default(MEDIUM)
  category   String
  unit       String     // Unit identifier
  createdAt  DateTime   @default(now())

  @@map("unit_4")
}

model Unit5Question {
  id         String     @id @default(cuid())
  question   String
  options    Json
  answer     String
  difficulty Difficulty @default(MEDIUM)
  category   String
  unit       String     // Unit identifier
  createdAt  DateTime   @default(now())

  @@map("unit_5")
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String?  @unique
  score          Int
  accuracy       Float
  timeTaken      Int
  answers        Json
  unit           String?
  totalQuestions Int?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
